# Keys the app may send (Authorization: Bearer …), comma separated.
MILU_API_KEYS=
# The "milu-api" Cloudflare tunnel; its credentials are ~/.cloudflared/<id>.json.
MILU_TUNNEL_ID=
HOST_UID=1000
HOST_GID=1000
OLLAMA_MODEL=gemma4:e4b

# While the Timi web runs, its Ollama:
COMPOSE_FILE=compose.yaml:compose.shared-llm.yaml
OLLAMA_URL=http://ollama:11434
# After it stops, this server's own:
# COMPOSE_FILE=compose.yaml
# COMPOSE_PROFILES=llm
# OLLAMA_URL=http://llm:11434
